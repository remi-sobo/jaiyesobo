{
  "expo": {
    "name": "Run It Back",
    "slug": "run-it-back-picks",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "runitback",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0B0B0C",
    "ios": {
      "bundleIdentifier": "com.sobo.runitback",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:jaiyesobo.com",
        "applinks:www.jaiyesobo.com"
      ],
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#0B0B0C",
      "resizeMode": "contain"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0C",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E11D2E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://jaiyesobo.com"
    }
  }
}
