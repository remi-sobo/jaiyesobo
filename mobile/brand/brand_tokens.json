{
  "brand": "Run It Back Picks",
  "version": "1.0",
  "colors": {
    "ink": "#0B0B0C",
    "accent": "#E11D2E",
    "paper": "#F7F7F8",
    "steel": "#9CA3AF",
    "surface": "#151517",
    "surface2": "#1E1E21",
    "line": "#2A2A2E",
    "win": "#4ADE80",
    "loss": "#F97316"
  },
  "type": {
    "display": {
      "family": "Archivo",
      "weight": 900,
      "style": "italic",
      "stretch": "115%",
      "fallback": "Arial Black, sans-serif"
    },
    "heading": {
      "family": "Archivo",
      "weight": 900,
      "stretch": "112%"
    },
    "ui": {
      "family": "Inter",
      "fallback": "system-ui"
    },
    "data": {
      "family": "JetBrains Mono",
      "minSize": 12,
      "fallback": "ui-monospace"
    }
  },
  "radius": {
    "card": 18,
    "button": 14,
    "sheet": 28
  },
  "motion": {
    "base": "250ms",
    "easing": "cubic-bezier(.2,.8,.2,1)",
    "direction": "enter from right, exit left"
  },
  "assets": {
    "appIcon": "png/app_icon_1024.png",
    "appIconVector": "app_icon.svg",
    "appIconSmall": "app_icon_small.svg",
    "favicon": "png/favicon_32.png",
    "appleTouch": "png/app_icon_180.png",
    "markOnLight": "symbol_color.svg",
    "markOnDark": "symbol_reversed.svg",
    "logoLight": "wordmark_horizontal_light.svg",
    "logoDark": "wordmark_horizontal_dark.svg",
    "stackedLight": "wordmark_stacked_light.svg",
    "stackedDark": "wordmark_stacked_dark.svg",
    "socialAvatar": "png/social_avatar_400.png"
  }
}