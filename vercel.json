{
  "functions": {
    "app/api/upload/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/cron/sportsbook?job=nightly", "schedule": "0 10 * * *" },
    { "path": "/api/cron/sportsbook?job=weekly", "schedule": "0 11 * * 1" },
    { "path": "/api/cron/sportsbook?job=closeout", "schedule": "*/15 2-11 * * 1" }
  ]
}
